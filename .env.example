# Скопируйте в .env и при необходимости поменяйте. Реальные секреты в репозиторий не кладём.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trainer
DATABASE_URL=postgresql+psycopg://trainer:change_me@db:5432/trainer

# Режим модели: stub (заглушка) или ollama
LLM_MODE=stub
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Ограничения запуска кода кандидата
SANDBOX_TIMEOUT_SEC=5
SANDBOX_MEMORY_MB=128
